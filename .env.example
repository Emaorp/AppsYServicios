# Copia este archivo como .env y completa los valores. NUNCA subas el .env a GitHub.

# --- PostgreSQL (valores en la tarea de Teams) ---
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- MQTT ---
MQTT_BROKER=
MQTT_PORT=1883
# Tópico del sensor asignado: iot/sensors/{codigo}/data
MQTT_TOPIC=iot/sensors/TEST-001/data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
